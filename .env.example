# Optional: point Live mode at an existing Base Sepolia deployment.
# Leave empty to deploy MockUSDC + UpHealthSLA from your own wallet on /contracts.
# Both must be valid addresses (0x + 40 hex), or neither is used.
NEXT_PUBLIC_UPHELD_SLA_ADDRESS=
NEXT_PUBLIC_MOCK_USDC_ADDRESS=

# Optional: deployment proof shown on /contracts#proof (links to sepolia.basescan.org).
# Each must be a transaction hash (0x + 64 hex); anything else is ignored.
# A recordOutage transaction sent by an attestor on the deployment above:
NEXT_PUBLIC_PROOF_OUTAGE_TX=
# A claimCompensation transaction (the live console on /contracts shows this hash after a claim):
NEXT_PUBLIC_PROOF_CLAIM_TX=

# Never put private keys or seed phrases in this file. Nothing in UpHeld needs one.
